# Copy to env.local in the same folder and uncomment only local overrides.
# Conventional HOME, AppData, Program Files, Git Bash, and PATH locations are
# derived at runtime. This trusted Bash assignment file must not hold secrets.

# FIREFOX_EXE="/drive/path/to/firefox.exe"
# VIM_DIR="/drive/path/to/vim"
# YAZI_FILE_ONE="X:\\path\\to\\file.exe"
# YAZI_CONFIG_HOME="/drive/path/to/yazi/config"
# GIT_BASH_LAUNCHER="/drive/path/to/git-bash.exe"

# Firefox container opened by yt-jp.
# YT_JP_CONTAINER_NAME="Google JP"