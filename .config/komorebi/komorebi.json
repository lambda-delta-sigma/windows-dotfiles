{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "transparency": true,
  "transparency_alpha": 252,
  "default_workspace_padding": 8,
  "default_container_padding": 6,
  "border": true,
  "border_width": 4,
  "border_offset": 0,
  "mouse_follows_focus": false,
  "animation": {
    "enabled": true,
    "duration": 150,
    "fps": 300,
    "style": {
        "movement":"EaseInOutQuad",
        "transparency": "Linear"
      }
  },
  "border_colours": {
    "single": "#DDC7A1",
    "unfocused": "#5A524C",
    "floating": "#DDC7A1",
    "monocle": "#DDC7A1"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP",
          "workspace_rules": [
            { "kind": "Exe", "id": "thunderbird.exe", "matching_strategy": "Equals" },
            { "kind": "Exe", "id": "Discord.exe", "matching_strategy": "Equals" }
          ]
        },
        {
          "name": "II",
          "layout": "BSP"
        },
        {
          "name": "III",
          "layout": "BSP"
        },
        {
          "name": "IV",
          "layout": "BSP"
        },
        {
          "name": "V",
          "layout": "BSP"
        },
        {
          "name": "VI",
          "layout": "BSP"
        },
        {
          "name": "VII",
          "layout": "BSP"
        }
      ]
    }
  ],

  "ignore_rules": [
    { "kind": "Exe", "id": "StartMenuExperienceHost", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "SearchHost", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "ShellExperienceHost", "matching_strategy": "Equals" },
    { "kind": "Class", "id": "Shell_TrayWnd", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "ScreenClippingHost", "matching_strategy": "Equals" },

    { "kind": "Exe", "id": "WindowsTerminal.exe", "matching_strategy": "Equals" },

    [
      { "kind": "Exe", "id": "steamwebhelper", "matching_strategy": "Equals" },
      { "kind": "Title", "id": ".*Big Picture.*", "matching_strategy": "Regex" }
    ],

    { "kind": "Exe", "id": "(?i)warframe", "matching_strategy": "Regex" },
    { "kind": "Exe", "id": "(?i)palworld", "matching_strategy": "Regex" },
    { "kind": "Exe", "id": "(?i)deadlock", "matching_strategy": "Regex" },
    { "kind": "Exe", "id": "(?i)deadbydaylight", "matching_strategy": "Regex" },
    { "kind": "Exe", "id": "(?i).*pathofexile.*", "matching_strategy": "Regex" },
    { "kind": "Exe", "id": "[A-Za-z0-9]*vermintide[A-Za-z0-9]*.exe", "matching_strategy": "Regex" },
    { "kind": "Exe", "id": "FINAL FANTASY XI", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "FINAL FANTASY XIV", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "ffxiv_[A-Za-z0-9]*.exe", "matching_strategy": "Regex" },

    [
      { "kind": "Title", "id": "[Pp]icture.in.[Pp]icture", "matching_strategy": "Regex" },
      { "kind": "Class", "id": "Chrome_WidgetWin_1|MozillaDialogClass", "matching_strategy": "Regex" }
    ],

    [
      { "kind": "Exe", "id": "Lively", "matching_strategy": "Equals" },
      { "kind": "Class", "id": "HwndWrapper", "matching_strategy": "Regex" }
    ]
  ],

  "floating_applications": [
    { "kind": "Class", "id": "#32770", "matching_strategy": "Equals" },

    [
      { "kind": "Exe", "id": "ApplicationFrameHost", "matching_strategy": "Equals" },
      { "kind": "Title", "id": "Calculator", "matching_strategy": "Equals" }
    ],

    [
      { "kind": "Exe", "id": "Discord", "matching_strategy": "Equals" },
      { "kind": "Title", "id": "Discord Popout|Screen Share", "matching_strategy": "Regex" }
    ],
    { "kind": "Exe", "id": "anki.exe", "matching_strategy": "Equals" },
    [
      { "kind": "Exe", "id": "anki.exe", "matching_strategy": "Equals" },
      { "kind": "Title", "id": "Add", "matching_strategy": "Equals" }
    ],
    [
      { "kind": "Exe", "id": "anki.exe", "matching_strategy": "Equals" },
      { "kind": "Title", "id": "^Browse", "matching_strategy": "Regex" }
    ],
    [
      { "kind": "Exe", "id": "anki.exe", "matching_strategy": "Equals" },
      { "kind": "Title", "id": "^Sync", "matching_strategy": "Regex" }
    ],
    { "kind": "Exe", "id": "XIVLauncher.exe", "matching_strategy": "Equals" },
    { "kind": "Exe", "id": "(?i)windower", "matching_strategy": "Regex" }
  ]
}
